# LinkPilot AI Configuration
# Security: Master key for AES-256-GCM credential encryption (32 url-safe base64-encoded bytes or 32-char secret)
LINKPILOT_MASTER_KEY=change-this-to-a-secure-32-byte-base64-key-in-production

# Database Configuration (supports SQLite for local development or PostgreSQL for production)
DATABASE_URL=sqlite:///./data/linkpilot.db
# DATABASE_URL=postgresql+psycopg2://linkpilot:secret@localhost:5432/linkpilot_db

# Storage Directories
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
EXPORTS_DIR=./data/exports
MANIFESTS_DIR=./data/manifests

# Resource & Rate Limits
MIN_DISK_FREE_MB=5000
MAX_WARC_RECORD_COMPRESSED_BYTES=10485760
MAX_WARC_PAYLOAD_DECOMPRESSED_BYTES=25165824
MAX_DECOMPRESSION_RATIO=50.0
MAX_JOB_DOWNLOAD_BYTES=524288000
CDX_REQUESTS_PER_SECOND=1.0
WARC_CONCURRENT_REQUESTS=5
WAYBACK_REQUESTS_PER_SECOND=2.0

# User Agent for Crawlers & APIs
CRAWLER_USER_AGENT=LinkPilotDataEngine/1.0 (+https://github.com/linkpilot/data-engine; bot@linkpilot.ai)
